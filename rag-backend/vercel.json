{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.js?path=$1"
    }
  ],
  "functions": {
    "index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/jobs/worker",
      "schedule": "0 0 * * *"
    }
  ]
}