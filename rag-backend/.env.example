# Server / Environment
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Appwrite (Server-side admin credentials & TablesDB IDs)
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a528873003897b6dbba
APPWRITE_DATABASE_ID=6a53b1a4002566268803
APPWRITE_TABLE_ID=articles
APPWRITE_SYNC_JOBS_TABLE_ID=6af2a4b5001496679e4c
APPWRITE_API_KEY=your_server_side_appwrite_api_key

# Qdrant Vector Database
QDRANT_URL=https://your-cluster-url.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=storynest

# OpenRouter Embeddings
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter Chat Model
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_CHAT_MAX_TOKENS=800

# RAG Retrieval Configuration
# SIMILARITY_THRESHOLD Tuning Guide:
# - 0.30 - 0.35: Broad recall (recommended for conversational queries)
# - 0.40 - 0.50: Balanced precision and recall
# - 0.55+: Strict matching (only high direct semantic overlap)
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5

# Rate Limiting (per IP)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Webhook Authentication Secret (for Appwrite database triggers)
WEBHOOK_SECRET=your_appwrite_webhook_signing_key
CRON_SECRET=your_vercel_cron_secret
